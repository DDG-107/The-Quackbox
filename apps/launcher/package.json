{
  "name": "@quackbox/launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The QuackBox host app: Electron shell, lobby and the in-process LAN hub.",
  "author": "The QuackBox contributors",
  "main": "dist/main/index.mjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "corepack pnpm build && electron .",
    "start": "electron .",
    "dev:server": "tsx watch src/server/standalone.ts",
    "build": "corepack pnpm build:main && corepack pnpm build:preload && corepack pnpm build:renderer",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main/index.mjs --external:electron --external:fastify --external:@fastify/static --external:ws --external:qrcode",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main/preload.cjs --external:electron",
    "build:renderer": "vite build",
    "dist": "electron-builder --config electron-builder.yml --publish never",
    "dist:dir": "electron-builder --config electron-builder.yml --dir",
    "dist:win": "electron-builder --config electron-builder.yml --win --publish never",
    "dist:mac": "electron-builder --config electron-builder.yml --mac --publish never",
    "dist:linux": "electron-builder --config electron-builder.yml --linux --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@quackbox/protocol": "workspace:*",
    "fastify": "^5.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.8"
  }
}
