{
  "name": "quackbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The QuackBox — a LAN party platform. The host app runs the game on the big screen, phones are the controllers.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @quackbox/launcher dev",
    "dev:launcher": "corepack pnpm --filter @quackbox/launcher dev",
    "dev:hub": "corepack pnpm --filter @quackbox/launcher dev:server",
    "dev:controller": "corepack pnpm --filter @quackbox/controller dev",
    "build": "corepack pnpm --filter @quackbox/controller build && corepack pnpm --filter @quackbox/launcher build",
    "start": "corepack pnpm --filter @quackbox/launcher start",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "eslint .",
    "license-check": "tsx tools/license-check/src/index.ts",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm license-check",
    "sim": "tsx scripts/sim.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@quackbox/protocol": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "ws": "^8.18.0"
  }
}
