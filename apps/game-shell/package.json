{
  "name": "@quackbox/game-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The standalone QuackBox game application: window, game link and local hub.",
  "author": "The QuackBox contributors",
  "main": "dist/main/index.mjs",
  "scripts": {
    "build": "corepack pnpm build:main && corepack pnpm build:preload",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main/index.mjs --external:electron --external:fastify --external:@fastify/static --external:ws --external:qrcode",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main/preload.cjs --external:electron",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@quackbox/hub": "workspace:*",
    "@quackbox/protocol": "workspace:*",
    "fastify": "^5.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
